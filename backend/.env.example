# ───────────────────────────────────────────
# HunarHub Backend – Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ───────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hunarhub

# JWT (use a strong random secret in production)
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# CORS – allow requests from the React dev server and deployed frontend (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,https://hunarhub-hazel.vercel.app

# AI Service (Python)
AI_SERVICE_URL=http://localhost:8000
