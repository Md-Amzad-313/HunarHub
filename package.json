{
  "name": "hunarhub",
  "version": "1.0.0",
  "private": true,
  "description": "HunarHub – Digital Marketplace for Local Micro-Entrepreneurs (monorepo root scripts)",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:client": "cd frontend && npm run dev",
    "dev:server": "cd backend && npm run dev",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "install:client": "cd frontend && npm install",
    "install:server": "cd backend && npm install",
    "install:all": "npm run install:frontend && npm run install:backend"
  },
  "keywords": ["hunarhub", "marketplace", "micro-entrepreneurs"],
  "author": "HunarHub Team",
  "license": "MIT"
}
