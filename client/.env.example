# ── HunarHub Frontend Environment Variables ──
# Copy to .env and set values. Never commit .env!

# API Base URL – used by the Axios service layer.
# In development, Vite's proxy forwards /api to localhost:5000
# so this can be left as /api.
VITE_API_BASE_URL=/api

# App name (used in <title> or meta tags if needed)
VITE_APP_NAME=HunarHub
